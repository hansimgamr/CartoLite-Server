# Copy this file to .env. Keep .env and .secrets private.
CARTOLITE_IMAGE=cartolite-server:local
CARTOLITE_VERSION=0.1.0
CARTOLITE_BIND_ADDR=127.0.0.1
CARTOLITE_PORT=8080
CARTO_BASEMAP_API_KEY_FILE=.secrets/carto-basemap-api-key

# Optional. Same-origin path of a reverse proxy that appends the CARTO key
# server-side (see docs/deployment.md). When set, no key is compiled into the
# frontend and the browser makes no third-party request for geography; leave
# CARTO_BASEMAP_API_KEY_FILE pointing at an absent file in that case.
CARTO_TILE_BASE=
# Optional. Origin of a companion status console to link to from the topbar and
# the node inspector. Empty leaves both out.
STATUS_CONSOLE_ORIGIN=
# Optional. Home view as "west,south,east,north" for a deployment covering one
# region, instead of fitting the bounding box of every node heard. Bounds rather
# than a centre and zoom, so the framing stays right on a phone too.
HOME_BOUNDS=
# Optional public area preset (R2 boundary preview; live filtering follows in R3).
# ID: lowercase URL slug, excluding all/custom. Bounds: west,south,east,north.
# Keep deployment-specific regions out of the generic source defaults.
AREA_PRESET_ID=
AREA_PRESET_LABEL=
AREA_PRESET_BOUNDS=

# Your standard MeshCore MQTT feed.
MQTT_BROKER_URL=tcp://broker.example.invalid:1883
MQTT_TOPIC=meshcore/#
MQTT_CLIENT_ID=cartolite-server
MQTT_USERNAME=
MQTT_PASSWORD=
# Empty accepts every valid region. Set exact comma-separated region labels to filter.
REGION_ALLOWLIST=
MQTT_INGEST_QUEUE_SIZE=4096

# Runtime state is a single atomic checkpoint, not an event database.
STATE_PATH=/data/state-v1.json
LOG_LEVEL=info
